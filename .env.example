# Environment Configuration for EcoSort AI (Sprint 1 Foundation)

# Core Application Settings
APP_NAME="EcoSort AI"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_jwt_key_ecosort_ai_sprint_1_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="ecosort_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# File Upload Security Settings
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp"

# Firebase Credentials (Path or raw JSON string for optional Firebase auth verification)
FIREBASE_CREDENTIALS_FILE=""

# AI Engine Settings
AI_MODEL_PATH="packages/ai-engine/saved_models/mobilenetv3_waste_v1.tflite"
MIN_CONFIDENCE_THRESHOLD=0.70
